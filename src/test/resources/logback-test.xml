<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests stay quiet (WARN) so results aren't buried under 44 concurrency runs of INFO lines.
     RefillLoggingTest raises com.snackcounter to INFO itself when it checks the log. -->
<configuration>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %5p [%15.15t] %-22.22logger{0} : %m%n</pattern>
    </encoder>
  </appender>
  <logger name="com.snackcounter" level="WARN"/>
  <root level="WARN">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
